<?xml version="1.0" encoding="utf-8"?>


<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DashboardActivity">


    <ScrollView
        android:scrollbars="none"
        android:layout_above="@id/navbarnya"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout

                android:id="@+id/navBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:clickable="true"
                    android:background="?actionBarItemBackground"
                    android:contentDescription="Add Story"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/outline_add_24"
                    android:gravity="center" />

                <TextView
                    android:textAllCaps="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_weight="3"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:drawableRight="@drawable/outline_arrow_drop_down_24"
                    android:gravity="center"
                    android:text="jtipnup" />

                <ImageView
                    android:clickable="true"
                    android:background="?actionBarItemBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@id/menu"
                    android:layout_weight="1"
                    android:contentDescription="Threats"
                    android:src="@drawable/outline_alternate_email_24"
                    android:gravity="center"
                    android:text="" />


                <ImageView
                    android:id="@+id/menu"
                    android:clickable="true"
                    android:background="?actionBarItemBackground"
                    android:contentDescription="Settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:src="@drawable/outline_clear_all_24"
                    android:gravity="center"
                    android:text="" />

            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/wadahProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/navBar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <ImageView
                    android:id="@+id/img"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginRight="30dp"
                    android:src="@drawable/jtik" />

                <TextView
                    android:id="@+id/textJTIK"
                    android:textColor="#000"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/outline_check_circle_24"
                    android:layout_toEndOf="@id/img"
                    android:text="JTIK PNUP" />


                <LinearLayout
                    android:id="@+id/wadahPost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/textJTIK"
                    android:layout_gravity="center"
                    android:layout_toEndOf="@id/img"
                    android:orientation="horizontal">


                    <RelativeLayout
                        android:clickable="true"
                        android:background="?actionBarItemBackground"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">


                        <TextView
                            android:id="@+id/teks90"
                            android:textColor="#000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#000"
                            android:layout_below="@id/teks90"
                            android:text="Postingan"/>

                    </RelativeLayout>


                    <RelativeLayout
                        android:clickable="true"
                        android:background="?actionBarItemBackground"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/teksPengikut"
                            android:textColor="#000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.018" />

                        <TextView
                            android:textColor="#000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/teksPengikut"
                            android:text="pengikut"/>

                    </RelativeLayout>

                    <RelativeLayout
                        android:clickable="true"
                        android:background="?actionBarItemBackground"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/teksMengikuti"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="58"
                            android:textColor="#000"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/teksMengikuti"
                            android:text="mengikuti"
                            android:textColor="#000"/>

                    </RelativeLayout>

                </LinearLayout>


            </RelativeLayout>

            <LinearLayout
                android:id="@+id/bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/wadahProfile"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Peruguran Tinggi dan Universitas" />

                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Official Account" />

                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Jurusan Teknik Informatika dan Komputer" />

                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Politeknik Negeri Ujung Pandang" />

                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="---------------------------------------------" />

                <TextView
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:drawableStart="@drawable/outline_add_link_24"
                    android:text="tik.poliupg.ac.id dan 3 lainnya" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/teksTombol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/bio"
                android:layout_margin="10dp"
                android:paddingStart="5dp"
                android:orientation="horizontal">


                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:backgroundTint="#ffffff"
                    android:drawableTint="@color/black"
                    android:text="JTIK PNUP"
                    android:textColor="@color/black"
                    android:textSize="10sp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/facebook_24"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:text="Info Kontak"
                    android:textSize="10sp"
                    android:drawableTint="@color/black"
                    app:iconGravity="textStart"
                    app:icon="@drawable/outline_call_24"
                    android:backgroundTint="#ffffff"
                    android:layout_marginRight="5dp"
                    app:cornerRadius="10dp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButton
                    android:text="Tambahkan"
                    android:textSize="10sp"
                    android:drawableTint="@color/black"
                    app:iconGravity="textStart"
                    app:icon="@drawable/outline_add_12"
                    android:backgroundTint="#ffffff"
                    app:cornerRadius="10dp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/teksDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/teksTombol"
                android:layout_margin="10dp"
                android:background="@drawable/button"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_toEndOf="@id/img"
                    android:text="Dashboard Profesional"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:layout_toEndOf="@id/img"
                    android:text="Fitur baru kini tersedia" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tmbol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/teksDashboard"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:backgroundTint="#f1f2f6"
                    android:drawableTint="@color/white"
                    android:text="Edit Profil"
                    android:textColor="@color/black"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:backgroundTint="#f1f2f6"
                    android:drawableTint="@color/white"
                    android:text="Bagikan Profil"
                    android:textColor="@color/black"
                    app:cornerRadius="10dp" />

            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/scrolHori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tmbol"
                android:scrollbars="none">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp">


                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="100dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:layout_marginRight="10dp"
                        android:layout_height="100dp"
                        android:src="@drawable/logoppl"
                        android:scaleType="centerCrop"
                        app:strokeColor="#f5f5f5f5"
                        app:strokeWidth="4dp"
                        android:padding="3dp"
                        app:shapeAppearanceOverlay="@style/CircleImage" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:layout_width="100dp"
                        android:layout_marginRight="10dp"
                        android:layout_height="100dp"
                        android:src="@drawable/logoppl"
                        android:scaleType="centerCrop"
                        app:strokeColor="#f5f5f5f5"
                        app:strokeWidth="4dp"
                        android:padding="3dp"
                        app:shapeAppearanceOverlay="@style/CircleImage" />


                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="100dp"
                        android:layout_marginRight="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:layout_height="100dp"
                        android:src="@drawable/logoppl"
                        android:scaleType="centerCrop"
                        app:strokeColor="#f5f5f5f5"
                        app:strokeWidth="4dp"
                        android:padding="3dp"
                        app:shapeAppearanceOverlay="@style/CircleImage" />


                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="100dp"
                        android:layout_marginRight="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:layout_height="100dp"
                        android:src="@drawable/logoppl"
                        android:scaleType="centerCrop"
                        app:strokeColor="#f5f5f5f5"
                        app:strokeWidth="4dp"
                        android:padding="3dp"
                        app:shapeAppearanceOverlay="@style/CircleImage" />


                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="100dp"
                        android:layout_marginRight="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:layout_height="100dp"
                        android:src="@drawable/logoppl"
                        android:scaleType="centerCrop"
                        app:strokeColor="#f5f5f5f5"
                        app:strokeWidth="4dp"
                        android:padding="3dp"
                        app:shapeAppearanceOverlay="@style/CircleImage" />


                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="100dp"
                        android:layout_marginRight="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:layout_height="100dp"
                        android:src="@drawable/logoppl"
                        android:scaleType="centerCrop"
                        app:strokeColor="#f5f5f5f5"
                        app:strokeWidth="4dp"
                        android:padding="3dp"
                        app:shapeAppearanceOverlay="@style/CircleImage" />



                </LinearLayout>

            </HorizontalScrollView>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/scrolHori"
                android:orientation="vertical"
                android:padding="10dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_marginBottom="5dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:clickable="true"
                        android:background="?actionBarItemBackground"
                        android:layout_height="120dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/naruto" />

                    <ImageView
                        android:layout_width="0dp"
                        android:clickable="true"
                        android:background="?actionBarItemBackground"
                        android:layout_height="120dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/narutolg" />

                    <ImageView
                        android:clickable="true"
                        android:background="?actionBarItemBackground"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/baryon" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/naruto" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/narutolg" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/baryon" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/naruto" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/narutolg" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/baryon" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="90dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/naruto" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="90dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/narutolg" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="90dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/baryon" />

                </LinearLayout>


            </LinearLayout>


        </LinearLayout>


    </ScrollView>

    <!--    di bawah adalah menu-->
    <LinearLayout
        android:id="@+id/navbarnya"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:background="?actionBarItemBackground"
            android:src="@drawable/baseline_home_24"
            android:gravity="center"
            android:text="Home" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:background="?actionBarItemBackground"
            android:src="@drawable/outline_auto_read_play_24"
            android:gravity="center"
            android:text="Reels" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:background="?actionBarItemBackground"
            android:src="@drawable/outline_cancel_schedule_send_24"
            android:gravity="center"
            android:text="Message" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:background="?actionBarItemBackground"
            android:src="@drawable/baseline_search_24"
            android:gravity="center"
            android:text="Search" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Switch Account"
            android:background="?actionBarItemBackground"
            android:src="@drawable/jtik"
            android:gravity="center"
            android:text="Profile" />

    </LinearLayout>

</RelativeLayout>